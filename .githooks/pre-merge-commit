#!/bin/sh
# 非快进自动合并提交不触发 pre-commit（issue #404）：在 pre-merge-commit
# 执行仓库统一的 SonarQube 零问题门禁，通过后记录树标记，供同一次操作
# 中同一 Git 进程后触发的 prepare-commit-msg 去重（issues #404/#429）。
# 门禁前执行 materialize --stage-for-commit（issue #548）：把待物化门禁
# 记录并入版本化 gate-history.jsonl 并暂存台账（含上次推送物化后遗留的
# 未暂存行）进本合并提交——服务端证据核验读到「滞后一次提交」的账本。
# 暂存尽力而为，失败只警告、不阻塞提交。

set -eu

hook_directory=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
"$hook_directory/../scripts/gate-history.sh" materialize --stage-for-commit
"$hook_directory/../scripts/sonar-quality-gate.sh"
"$hook_directory/../scripts/gate-tree-marker.sh" write "${PPID:-}"
