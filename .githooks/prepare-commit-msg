#!/bin/sh
# revert / cherry-pick / rebase 重放的自动提交不触发 pre-commit，也没有
# commit-msg（issue #404）：在其唯一的前置钩子 prepare-commit-msg 补上
# 仓库统一的 SonarQube 零问题门禁。同一次提交操作内 pre-commit /
# pre-merge-commit 刚过检的树经 gate-tree-marker 去重——普通 git commit
# 与合并不重复跑门禁；无新鲜同树、同 Git 进程标记即执行完整门禁（#429；--no-verify 跳过
# pre-commit 时由此兜底，提交侧不再能绕过）。本钩子只消费标记、回退
# 门禁通过后不写标记：同操作内没有下游消费者，写了只会让后续操作
# （如又一次同树 --no-verify 提交）复用（评审 4120239723）。
# 本路径【不】物化台账（issue #548）：sequencer 重放不采纳钩子对索引的
# 追加暂存，物化会留下脏工作树中止后续重放（PR #415 评审 5338815626）；
# 重放产生的记录留在待物化文件，随下一个普通提交（pre-commit 路径的
# materialize --stage-for-commit）并入。

set -eu

hook_directory=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if "$hook_directory/../scripts/gate-tree-marker.sh" check "${PPID:-}"; then
  exit 0
fi
PLOTWEAVE_GATE_SCOPE=full "$hook_directory/../scripts/sonar-quality-gate.sh"
