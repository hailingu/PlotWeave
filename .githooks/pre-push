#!/bin/sh
# 推送前按 stdin 的待推送 ref 分派仓库统一的 SonarQube 零问题门禁
#（issue #405）：推哪个 ref，就在该 ref 的提交状态上分析哪个 ref，而非
# 恒扫当前工作树。快路径：待推提交即当前 HEAD、索引与工作树对 HEAD 均
# 无内容差异、且整个仓库没有未忽略的未跟踪文件时，当前工作树就是
# 被推状态，直接执行该范围的门禁（full 与提交钩子仍为完整门禁）。测试及其导入的辅助
# 文件、夹具可在任意目录参与覆盖率，未跟踪输入统一触发慢路径隔离。
# 慢路径：其余情形——被推提交非当前工作树可证等价的状态（非检出分支、
# 脏工作树、一次推送中与 HEAD 可证等价之外的其他提交）——在临时
# worktree 检出被推提交、按该树锁文件安装依赖后，用当前门禁脚本
#（PLOTWEAVE_GATE_REPOSITORY_ROOT 指向临时 worktree）完整分析：以被
# 推送 ref 为准，且不触碰本地工作树。快/慢按唯一提交逐个判定，与同次
# 推送还包含哪些 ref 无关（推分支 + 同提交标签仍是一次快路径门禁）。
# 慢路径启动前输出首个不成立的快路径前提（issue #463 稳定诊断代码，
# 见 docs/development/quality-gate-push.md），使慢路径成本来源当场可见；
# 该输出只作诊断，不参与快/慢判定。
# 变更范围（owner 指示 2026-10-18，见 quality-gate-push.md「Scoped Push
# Routing」）：先按 base..commit 分类。docs-only 只跑 check-docs.sh，不
# 安装依赖、不做覆盖率/Sonar、不写推送台账；单栈只跑该栈全量回归与覆盖
# 率，另一栈复用主工作树最近 LCOV——该复用仅限快路径（当前工作树可证
# 等价被推提交）：慢路径无法证明主工作树报告属于被推树的未变更栈，单栈
# 自动提升为 full，两栈覆盖率在临时 worktree 内按被推树刷新（issue #805，
# 诊断代码 PRE_PUSH_SCOPE_ESCALATED）；跨栈/工具/未知/无基线走完整门禁。
# commit-creating 钩子仍是完整统一门禁，不受此分派影响。
# 同一提交被多个 ref 引用（分支 + 标签）只分析一次；删除 ref（本地
# sha 全零）不导出代码，跳过。末行缺尾随换行的清单按字段残留检测并
# fail-closed（issue #464）：真实 git 每行都以换行结束，只有手工或包装
# 调用可产生该形态，不可静默放行。推送自 PR #581 评审 5537970549 起
# 【不】物化台账：推送产生的记录与提交侧记录一并留在 .git 内待物化文
# 件，由下一次提交创建钩子（pre-commit / pre-merge-commit 的
# materialize --stage-for-commit）按待物化内容字节精确归因后并入并暂
# 存——推送不再给工作树留下未暂存的被跟踪差异，快路径的台账失效来源
# 随之消失，人工台账改动也不会被误收编（issue #355；PR #415 评审
# 5338815626 的未暂存写保护语义保持）。
# 安装执行器与门禁脚本这两类分钟级子进程经 supervise_child_process 后台
# 作业 + wait 受监督运行，INT/HUP/TERM 先整组终止子进程再走退出清理，
# 临时 worktree 不再因前台子进程推迟 trap 而滞留数分钟；清理警告只在
# 目录确实留存时出现（issue #465，代码契约见 quality-gate-push.md）。

set -eu

# 禁用本地替换对象（PR #442 评审 5361127076）：push 传输原始对象，
# 解析、等价检查、worktree 检出和子进程台账也必须读取原始被推对象。
# 环境变量只作用于本钩子及其后代，不修改调用方环境或 refs/replace。
export GIT_NO_REPLACE_OBJECTS=1

hook_directory=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
main_root=$(CDPATH= cd -- "$hook_directory/.." && pwd)
npm_bin=${PLOTWEAVE_NPM_BIN:-npm}
node_bin=${PLOTWEAVE_NODE_BIN:-node}
zero_sha=0000000000000000000000000000000000000000

# #917: resolve before entering any slow-path checkout; all worktrees use one durable queue/mutex.
shared_git_directory=$(git -C "$main_root" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || printf '%s' "$main_root/.git")
pending_path=${PLOTWEAVE_GATE_PENDING_PATH:-$shared_git_directory/plotweave-gate-history.pending}
lock_directory=${PLOTWEAVE_SONAR_LOCK_DIRECTORY:-$shared_git_directory/plotweave-sonar-gate.lock}

# 慢路径临时 worktree 与 ref 清单临时文件的登记与清理：退出路径（含
# set -e 失败与信号）尽力移除；残留只浪费磁盘、不影响门禁结论（可用
# git worktree prune 兜底）。
temp_root=
temp_worktree=
manifest_path=
scope_manifest_path=
# 受监督子进程组（issue #465）：非空表示有分钟级子进程（安装或门禁）
# 正以后台作业运行，其进程组号即本值，供信号路径整组终止。
supervised_group_pid=
# 快路径失败前提记录（issue #463）：working_tree_represents_head 返回非零
# 时填充，供慢路径分派输出触发原因；空初值仅为 set -u 安全。
fast_path_block_code=
fast_path_block_detail=

# Keep one initialization/trap owner; both libraries only define callable helpers.
. "$main_root/scripts/pre-push-runtime.sh"
. "$main_root/scripts/pre-push-protocol.sh"
trap cleanup_temporary_artifacts 0
trap 'handle_termination_signal 129' 1
trap 'handle_termination_signal 130' 2
trap 'handle_termination_signal 143' 15

# 一次读尽 stdin（git 每行给出 <本地ref> <本地sha> <远端ref> <远端sha>），
# 落到临时清单后逐行分派：循环体内的长命令一律改读 /dev/null，不再消费
# 钩子的输入；清单经文件传递，规避子壳变量与引号展开两类陷阱。
manifest_path=$(mktemp "${TMPDIR:-/tmp}/plotweave-pre-push-refs.XXXXXX")
cat > "$manifest_path"
scope_manifest_path=$(mktemp "${TMPDIR:-/tmp}/plotweave-pre-push-scopes.XXXXXX")
while read -r local_ref local_sha remote_ref remote_sha extra; do
  if [ -z "$local_ref" ]; then
    continue
  fi
  if [ -n "$extra" ]; then
    fail "待推送 ref 行字段数异常（预期 <本地ref> <本地sha> <远端ref> <远端sha>）：$local_ref $local_sha $remote_ref $remote_sha $extra"
  fi
  # 删除 ref：本地 sha 全零，没有代码离机，无需分析
  if [ "$local_sha" = "$zero_sha" ]; then
    continue
  fi
  commit=$(resolve_pushed_commit "$local_sha") ||
    fail "无法把待推送对象 $local_sha 解析为提交：$local_ref"
  collect_ref_scope
done < "$manifest_path"
# read 遇到缺尾随换行的末行不会执行循环体，但保留字段；必须 fail-closed（#464）。
if [ -n "${local_ref:-}" ]; then
  fail "待推送 ref 清单末行缺少尾随换行，该行未被分析：$local_ref $local_sha $remote_ref $remote_sha${extra:+ $extra}"
fi

analyzed_commits=
while read -r commit ref_scope local_ref; do
  # 同一提交被多个 ref 引用只分析一次
  case ",$analyzed_commits," in
    *",$commit,"*) continue ;;
  esac
  analyzed_commits="$analyzed_commits,$commit"
  # #941：每个实际发布对象须先通过真实 ub-mode 检查，文档范围也不豁免。
  "$node_bin" "$main_root/scripts/ub-mode-gate.ts" verify "$commit" ||
    fail "ub-mode 检查证据无效：$local_ref"
  short=$(git rev-parse --short "$commit")
  # 每次 ref 重置范围环境，避免同次多 ref 推送互相继承（owner 指示
  # 2026-10-18：文档/单栈分流；docs 不跑代码回归/覆盖率，单栈只跑该栈
  # 全量覆盖率，另一栈复用最近 LCOV——复用仅限快路径，见下）。
  unset PLOTWEAVE_GATE_SCOPE PLOTWEAVE_REUSED_FRONTEND_LCOV \
    PLOTWEAVE_REUSED_RUST_LCOV 2>/dev/null || :
  gate_scope=$(aggregate_commit_scope "$commit")
  if [ "$gate_scope" = 'docs' ]; then
    printf '[pre-push] 变更范围：%s（%s）\n' "$gate_scope" "$short"
    printf '%s\n' '[pre-push] 仅文档变更：跳过代码回归、覆盖率与 Sonar；commit 钩子的门禁记录保持不变。\n'
    continue
  fi
  # 快/慢判定先于范围环境设置（issue #805）：单栈复用 LCOV 指向主工作树
  # 固定路径，只有当前工作树可证等价被推提交（快路径）时，该报告才可
  # 证明与被推树同源；慢路径无法证明来源，单栈自动提升为 full——两栈
  # 覆盖率在临时 worktree 内按被推树刷新，主工作树旧报告不进入 Sonar
  # 或台账，消除「单栈推送按另一棵树的未变更栈覆盖率放行」的缺口。
  head_commit=$(git rev-parse --verify --quiet HEAD 2>/dev/null || printf x)
  # 慢路径触发原因（issue #463）：被推提交非 HEAD 用缺省值；被推提交即
  # HEAD 但不可证等价时取 working_tree_represents_head 记录的首个失败
  # 前提。原因只用于诊断输出，不参与快/慢判定本身。
  slow_code=PRE_PUSH_SLOW_NOT_HEAD
  slow_detail='被推提交不是当前 HEAD'
  fast_path_eligible=0
  if [ "$commit" = "$head_commit" ] && working_tree_represents_head; then
    fast_path_eligible=1
  elif [ "$commit" = "$head_commit" ]; then
    slow_code=$fast_path_block_code
    slow_detail=$fast_path_block_detail
  fi
  effective_scope=$gate_scope
  if [ "$gate_scope" != 'full' ] && [ "$fast_path_eligible" -ne 1 ]; then
    effective_scope=full
    printf '[pre-push] 范围提升（PRE_PUSH_SCOPE_ESCALATED）：慢路径无法证明复用 LCOV 属于被推树，%s 提升为 full——两栈覆盖率在被推树内刷新（issue #805）\n' \
      "$gate_scope"
  fi
  # full 推送保守覆盖全部实现栈（PR #604 评审 5560989008），提升而来的
  # full 同样执行三栈；pre-push 强制为 1，三个提交入口强制为 0。
  PLOTWEAVE_GATE_FULL_NATIVE=0
  if [ "$effective_scope" = 'full' ]; then
    PLOTWEAVE_GATE_FULL_NATIVE=1
  fi
  export PLOTWEAVE_GATE_FULL_NATIVE
  printf '[pre-push] 变更范围：%s（%s）\n' "$effective_scope" "$short"
  if [ "$effective_scope" != 'full' ]; then
    PLOTWEAVE_GATE_SCOPE=$effective_scope
    PLOTWEAVE_REUSED_FRONTEND_LCOV=$main_root/coverage/lcov.info
    PLOTWEAVE_REUSED_RUST_LCOV=$main_root/src-tauri/target/coverage/lcov-rust.info
    export PLOTWEAVE_GATE_SCOPE PLOTWEAVE_REUSED_FRONTEND_LCOV \
      PLOTWEAVE_REUSED_RUST_LCOV
  fi
  if [ "$fast_path_eligible" -eq 1 ]; then
    printf '[pre-push] 门禁对象：%s（%s，当前工作树）\n' "$local_ref" "$short"
    supervise_child_process run_gate_for_current_tree
  else
    printf '[pre-push] 快路径不可达（%s）：%s——改用临时 worktree 分析被推提交\n' \
      "$slow_code" "$slow_detail"
    printf '[pre-push] 门禁对象：%s（%s，临时 worktree）\n' "$local_ref" "$short"
    gate_commit_in_temp_worktree "$commit"
  fi
done < "$scope_manifest_path"
rm -f "$manifest_path"
manifest_path=

