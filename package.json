{
  "name": "plotweave",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "engines": {
    "node": "^24.18.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:native-canvas": "vite build --config vite.native-canvas.config.ts",
    "build:native": "npm run build:native-canvas && xcodebuild -project native/macos/PlotWeaveNative.xcodeproj -scheme PlotWeaveNative -destination 'platform=macOS' -derivedDataPath native/macos/build/DerivedData build",
    "typecheck:strict": "tsc --noEmit -p tsconfig.strict.json",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "tauri": "tauri",
    "test:coverage": "vitest run --coverage",
    "hooks:install": "git config core.hooksPath .githooks",
    "sonar:gate": "sh scripts/sonar-quality-gate.sh",
    "check:static": "sh scripts/check-static.sh",
    "check:size": "node scripts/check-file-size.ts",
    "check:workspace-drift": "node scripts/check-workspace-drift.ts"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@xyflow/react": "^12",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@tauri-apps/cli": "^2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "axe-core": "^4.13.0",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^5",
    "eslint-plugin-react-refresh": "^0.4",
    "globals": "^15",
    "happy-dom": "^20.11.12",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "typescript": "^5.6",
    "typescript-eslint": "^8",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
